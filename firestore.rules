rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Global Catch-All Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Helper Functions
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // 2. FAQs Collection
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if true; // Allow client modification for the admin workspace
    }

    // 3. Inquiries Collection
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if true; // Checked against administrative access
    }

    // 4. Feedback Collection
    match /feedback/{feedbackId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
  }
}
